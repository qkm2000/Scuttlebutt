{
  "name": "scuttlebutt",
  "version": "1.1.0",
  "description": "Record, transcribe, and summarize meetings in the Obsidian sidebar with local vLLM servers",
  "main": "main.js",
  "scripts": {
    "dev": "node ./esbuild.js",
    "build": "tsc --noEmit && node ./esbuild.js",
    "build:tests": "node ./esbuild.test.js",
    "typecheck": "tsc --noEmit",
    "test": "node ./esbuild.test.js && node --test .test-out/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "meeting",
    "transcription",
    "whisper",
    "summary"
  ],
  "author": "Kar Min",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.24.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
